# Copy to .env.local. Values below are placeholders, never real credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only MongoDB Atlas connection string. Database defaults to crowdplay.
DB_URL=
MONGODB_DB=crowdplay
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Confirm current provider pricing. Blank disables paid classification safely.
JEV_INPUT_USD_PER_MILLION=
JEV_OUTPUT_USD_PER_MILLION=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/twitch/callback
TWITCH_EVENTSUB_SECRET=
# 32 random bytes encoded as 64 hex characters; server-only AES-256-GCM key.
ENCRYPTION_KEY=
# A different random 32-byte hex secret for server sessions and confirmation tokens.
SESSION_SECRET=
# Used by Vercel cron / authenticated retry endpoint.
CRON_SECRET=
